.DS_Store
__pycache__/
*.py[cod]

# Local dependencies and generated benchmark evidence
vendor/
benchmark/runs/
.benchmark-*-backup-*/

# Third-party or hidden benchmark material
benchmark/tasks/
benchmark/network-test-task/
benchmark/pilot-manifest.json

# Pinned executables are documented by checksum, not redistributed
benchmark/bin/omp-*

# Local credentials and provider state
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
